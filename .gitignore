# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS / exFAT
.DS_Store
._*

# env
.env
.env.local

# prisma
prisma/*.db

# test artefacts
/test-results/
/playwright-report/
/coverage/

# keep the example env template
!.env.example

# per-workstream test env files
.env.test.*

# end-to-end build output
/.next-e2e/

# editorial content export — real people, never committed
editorial-export*.json

# vercel
.vercel
