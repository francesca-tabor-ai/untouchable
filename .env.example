# ---------------------------------------------------------------------------
# UnTouchable — environment template. Copy to .env.local and fill in.
# Never commit real secrets. Health data is UK GDPR special category data.
# ---------------------------------------------------------------------------

# Database (production target: UK region — AWS eu-west-2 or Supabase London)
DATABASE_URL="postgresql://localhost:5432/untouchable_dev"
SHADOW_DATABASE_URL="postgresql://localhost:5432/untouchable_shadow"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email. "console" logs to stdout in development; no mail is sent.
EMAIL_PROVIDER="console"
EMAIL_FROM="hello@untouchable.example"

# Privacy — minimum group size before aggregate results are disclosed.
# Never lower this without a documented DPIA review.
PRIVACY_MIN_GROUP_SIZE="10"

# Public, cookieless analytics for logged-out pages only. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# Research Scout (DECISIONS.md RS-02). All optional.
# Operator contact sent to NCBI and OpenAlex, as their terms ask. Never a user's address.
SCOUT_CONTACT_EMAIL=
# Raises NCBI's limit from 3 to 10 requests a second.
NCBI_API_KEY=
OPENALEX_API_KEY=
# Plain-English summaries, study types and email wording. Leave blank to keep Claude off:
# nothing is sent, and the Scout shows abstracts, index study types and a template email.
ANTHROPIC_API_KEY=
